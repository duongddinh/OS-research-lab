ape map = {} map["os"] = "jordyOS" tree map["os"]
tree graft("banana", " runtime")
tree inscribe("hello.txt", "Hello from Apelang") tree forage("hello.txt")
tumble { tree 1 ook 0 } catch (err) { tree "Caught runtime error" }
tree "DEMO PASS"
