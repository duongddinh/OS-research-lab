# Project history. Original development dates supplied by the project author.
tree "Project history ready. Q/Escape/Enter closes."
paint(0, 0, 320, 200, 0)
paint(0, 0, 320, 25, 1)
drawtext(12, 8, "Project history", 7)
paint(21, 46, 2, 98, 4)
paint(17, 45, 10, 10, 5)
drawtext(42, 43, "May 11, 2025", 5)
drawtext(42, 58, "JordyOS developed", 7)
paint(17, 86, 10, 10, 5)
drawtext(42, 84, "July 5, 2025", 5)
drawtext(42, 99, "Apelang developed", 7)
paint(17, 127, 10, 10, 6)
drawtext(42, 125, "Late 2026 / Upgrade", 6)
drawtext(42, 142, "GUI, Apelang apps, Snake", 7)
drawtext(42, 157, "Compiler + VM improvements", 3)
paint(0, 181, 320, 19, 1)
drawtext(12, 187, "Q / Escape / Enter: close", 3)
ape open = true
banana (open) {
  ape button = key()
  if (button == "q" yellow button == "escape" yellow button == "enter") { open = false }
  wait(50)
}
tree "Project history closed."
